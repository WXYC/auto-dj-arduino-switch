// Copy this file to secrets.h and fill in your credentials.
// secrets.h is gitignored -- never commit it.

#ifndef SECRETS_H
#define SECRETS_H

// UNC-PSK WiFi credentials (WiFi is the management-channel fallback transport).
// Register the Arduino's MAC address at https://unc.edu/mydevices first.
// The PSK password changes annually.
#define WIFI_SSID "UNC-PSK"
#define WIFI_PASS "your-psk-password-here"

// Orchestrator management-channel key. Sent as the X-Auto-DJ-Key header on the
// WebSocket upgrade and the HTTP fallback; must match the orchestrator's
// AUTO_DJ_KEY env var.
#define AUTO_DJ_KEY "your-orchestrator-key-here"

#endif
